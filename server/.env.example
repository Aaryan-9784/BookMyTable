# ════════════════════════════════════════════════════════════════════════════
# BookMyTable Server Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# 
# IMPORTANT: Never commit .env files with real credentials to version control!
# Copy this file to .env and replace all placeholder values with actual credentials.
#
# Generate secure secrets: openssl rand -base64 64
# ════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Connect your application
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE_NAME
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bookmytable?retryWrites=true&w=majority

# ─── Redis (OTP Storage & Caching) ──────────────────────────────────────────
# Option 1: Redis URL (for cloud providers like Redis Cloud, Heroku, AWS ElastiCache)
# Format: redis://username:password@host:port
# Example: redis://default:password@redis-12345.cloud.redislabs.com:12345
REDIS_URL=

# Option 2: Individual Redis connection parameters (for local or custom setup)
# Used if REDIS_URL is not provided
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Note: Redis is optional in development (falls back to memory storage)
#       but REQUIRED in production for multi-server deployments

# ─── Authentication & Security ──────────────────────────────────────────────
# JWT Secret - MUST be minimum 64 characters, cryptographically random
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secure-jwt-secret-minimum-64-characters-change-this-immediately

# CSRF Secret - Used for CSRF token generation (can use same as JWT_SECRET)
# Generate with: openssl rand -base64 64
CSRF_SECRET=your-super-secure-csrf-secret-minimum-64-characters-change-this-immediately

# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,admin2@example.com

# Optional: Comma-separated list of restaurant owner emails
RESTAURANT_EMAILS=restaurant@example.com

# ─── Supabase Authentication ────────────────────────────────────────────────
# Get keys from: https://supabase.com/dashboard/project/_/settings/api
# ⚠️ NEVER expose Service Role Key in client-side code!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Email Service (Gmail SMTP) ─────────────────────────────────────────────
# Gmail App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
# Note: Requires 2FA enabled on your Google account
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# ─── Email Service (Resend) ─────────────────────────────────────────────────
# Alternative/additional email service (3,000 free emails/month)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=BookMyTable <noreply@yourdomain.com>

# ─── File Storage (Cloudinary) ──────────────────────────────────────────────
# Get credentials from: https://cloudinary.com/console/settings/security
# Free tier: 25GB storage, 25GB bandwidth/month
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── AWS Services (Optional) ────────────────────────────────────────────────
# Only needed if using AWS Cognito or SES instead of Supabase/Gmail
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# SES_FROM_EMAIL=noreply@yourdomain.com

# ─── CORS Configuration ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (for production)
# Example: https://yourdomain.com,https://www.yourdomain.com
CLIENT_URL=http://localhost:5173

# ─── Redis (for OTP storage and session management) ────────────────────────
# Local: redis://localhost:6379
# Redis Cloud: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# ─── Rate Limiting Configuration ────────────────────────────────────────────
# Maximum requests per time window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoints rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ─── Feature Flags ──────────────────────────────────────────────────────────
# Enable/disable features for testing
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_REAL_TIME_NOTIFICATIONS=true
ENABLE_BOOKING_CONFIRMATIONS=true

# Password Security
# Check passwords against Have I Been Pwned breach database (adds ~300ms latency)
CHECK_PASSWORD_BREACH=false

# Development Authentication (NEVER enable in production!)
# Allows server-signed JWT authentication when Supabase is not configured
# ⚠️ CRITICAL: This bypasses Supabase auth - only for local development
DEV_AUTH_ENABLED=false

# Development OTP Bypass (NEVER enable in production!)
# Set to 'true' only in local development when testing without email service
# DEV_OTP_BYPASS=false
# DEV_OTP_BYPASS_CODE=your-complex-secret-bypass-code-here

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ════════════════════════════════════════════════════════════════════════════
# Security Checklist Before Production:
# ════════════════════════════════════════════════════════════════════════════
# [ ] All placeholder values replaced with actual credentials
# [ ] JWT_SECRET is minimum 64 random characters
# [ ] Database password is strong and unique
# [ ] ADMIN_EMAILS contains only authorized email addresses
# [ ] CLIENT_URL restricted to production domain(s) only
# [ ] NODE_ENV set to 'production'
# [ ] Email service credentials tested and working
# [ ] Redis connection string configured
# [ ] AWS security groups/firewall configured
# [ ] SSL/TLS certificates installed
# [ ] Monitoring and logging configured
# ════════════════════════════════════════════════════════════════════════════
