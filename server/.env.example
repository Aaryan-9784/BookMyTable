# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bookmytable?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your-super-secure-jwt-secret-minimum-64-characters-change-this-immediately
CSRF_SECRET=your-super-secure-csrf-secret-minimum-64-characters-change-this-immediately
ADMIN_EMAILS=admin@example.com

# Email Service (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Email Service (Resend - Optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=BookMyTable <noreply@yourdomain.com>

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_REAL_TIME_NOTIFICATIONS=true
ENABLE_BOOKING_CONFIRMATIONS=true
CHECK_PASSWORD_BREACH=false

# Development Flags
DEV_AUTH_ENABLED=false
DEV_OTP_BYPASS=false
# DEV_OTP_BYPASS_CODE=your-bypass-code

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# AWS (Optional - Cognito/SES)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# SES_FROM_EMAIL=
