# Dependencies
node_modules/
.pnp/
.pnp.js

# Build Outputs & Bundler Caches
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# Environment & Secret Files
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Test & Coverage
coverage/
.nyc_output/
*.lcov

# Linting & Caches
.eslintcache
.stylelintcache
.cache/

# OS Artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
