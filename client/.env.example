# ════════════════════════════════════════════════════════════════════════════
# BookMyTable Client Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# 
# IMPORTANT: Only include PUBLIC variables here (prefixed with VITE_)
# Never include sensitive keys or secrets in the frontend!
#
# Copy this file to .env for local development
# ════════════════════════════════════════════════════════════════════════════

# ─── API Configuration ──────────────────────────────────────────────────────
# Backend API URL
# Development: http://localhost:5000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:5000

# ─── Supabase Authentication (Public Keys Only) ─────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ⚠️ Only use anon (public) key - NEVER use service_role key in frontend!
# Free tier: 50,000 monthly active users
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# ─── Feature Flags ──────────────────────────────────────────────────────────
# Enable/disable features for testing
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false

# ─── Third-Party Services (Public Keys Only) ────────────────────────────────
# Google Analytics (optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry Error Tracking (optional)
# VITE_SENTRY_DSN=https://xxxxxxxxx@sentry.io/xxxxxxx

# ════════════════════════════════════════════════════════════════════════════
# Security Notes:
# ════════════════════════════════════════════════════════════════════════════
# ✅ All variables prefixed with VITE_ are PUBLIC and embedded in client bundle
# ✅ Never include API secrets, private keys, or service role keys
# ✅ Supabase anon key is safe to expose (has Row Level Security policies)
# ✅ Always validate and sanitize user input on the backend
# ════════════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════════════
# Production Checklist:
# ════════════════════════════════════════════════════════════════════════════
# [ ] VITE_API_URL points to production backend
# [ ] VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are production values
# [ ] Feature flags configured appropriately for production
# [ ] No sensitive data or secrets included
# [ ] Backend CORS configured to accept requests from frontend domain
# ════════════════════════════════════════════════════════════════════════════
