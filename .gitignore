# ════════════════════════════════════════════════════════════════════════════
# 🍽️ BookMyTable - Repository Git Ignore Configuration
# ════════════════════════════════════════════════════════════════════════════
# Specifies untracked files that Git should ignore across client, server, and root.
# Keep sensitive data, local credentials, build outputs, and dependencies out of version control.
# ════════════════════════════════════════════════════════════════════════════

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
bower_components/
jspm_packages/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
package-lock.json.lock
yarn.lock.lock
pnpm-lock.yaml.lock

# ─── Build & Bundler Outputs ────────────────────────────────────────────────
dist/
**/dist/
build/
**/build/
out/
.vite/
**/.vite/
.next/
.nuxt/
.docusaurus/
.vercel/
.output/
*.tsbuildinfo

# ─── Environment Variables (⚠️ NEVER COMMIT SENSITIVE KEYS!) ────────────────
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ─── Logs & Runtime Diagnostics ─────────────────────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
combined.log
error.log
access.log

# ─── Private Keys & Certificates (⚠️ NEVER COMMIT THESE!) ───────────────────
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.csr
*.der
*.cer
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ─── Deployment & Bundle Archives ────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.war
*.ear

# ─── OS Generated & System Files ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── IDE & Editor Configurations ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp
*~
.project
.classpath
.settings/
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Test & Coverage Outputs ────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
*.lcov
.jest/
test-results/
junit.xml
.coverage
htmlcov/
.pytest_cache/
.hypothesis/

# ─── Local Database Files ───────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.mongo

# ─── Cloud Infrastructure & Serverless ──────────────────────────────────────
.elasticbeanstalk/*
!.elasticbeanstalk/config.yml
!.elasticbeanstalk/*.cfg.yml
.aws-sam/
.amplify/
.chalice/
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
docker-compose.override.yml
.serverless/

# ─── Temporary Storage & File Uploads ───────────────────────────────────────
uploads/
**/uploads/
tmp/
**/tmp/
temp/
**/temp/
.cache/
.parcel-cache/
.turbo/
.sass-cache/
.eslintcache
.stylelintcache
