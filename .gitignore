# ════════════════════════════════════════════════════════════════════════════
# BookMyTable - Git Ignore Configuration
# ════════════════════════════════════════════════════════════════════════════
# This file specifies intentionally untracked files that Git should ignore.
# Always keep sensitive data, build outputs, and dependencies out of version control.
# ════════════════════════════════════════════════════════════════════════════

# ─── Dependencies ────────────────────────────────────────────────────────────
# Package manager files and installed dependencies
node_modules/
bower_components/
jspm_packages/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
package-lock.json.lock
yarn.lock.lock

# ─── Build Outputs ───────────────────────────────────────────────────────────
# Production builds and bundler outputs
dist/
build/
out/
.vite/
.next/
.nuxt/
.docusaurus/
.vercel/
.output/
*.tsbuildinfo

# ─── Environment Variables (⚠️ NEVER COMMIT THESE!) ─────────────────────────
# All environment files containing sensitive credentials
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ─── Logs ────────────────────────────────────────────────────────────────────
# Application and package manager logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
combined.log
error.log
access.log

# ─── Private Keys & Certificates (⚠️ NEVER COMMIT THESE!) ───────────────────
# SSL certificates, private keys, and security credentials
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.csr
*.der
*.cer
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ─── Deployment Archives ─────────────────────────────────────────────────────
# Generated deployment packages
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.war
*.ear

# ─── OS Generated Files ──────────────────────────────────────────────────────
# System-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk

# ─── IDE & Editor Config ─────────────────────────────────────────────────────
# Editor-specific files and folders
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp
*~
.project
.classpath
.settings/
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Testing ─────────────────────────────────────────────────────────────────
# Test coverage and reports
coverage/
.nyc_output/
*.lcov
.jest/
test-results/
junit.xml
.coverage
htmlcov/
.pytest_cache/
.hypothesis/

# ─── Database ────────────────────────────────────────────────────────────────
# Local database files
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.mongo

# ─── Cloud & Deployment ──────────────────────────────────────────────────────
# AWS Elastic Beanstalk
.elasticbeanstalk/*
!.elasticbeanstalk/config.yml
!.elasticbeanstalk/*.cfg.yml

# AWS Lambda
.aws-sam/
.chalice/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Docker
docker-compose.override.yml
.dockerignore

# Serverless Framework
.serverless/

# ─── Cache & Temporary ───────────────────────────────────────────────────────
# Cache folders and temporary files
.cache/
.parcel-cache/
.turbo/
.temp/
.tmp/
*.local
.sass-cache/
.eslintcache
.stylelintccache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ─── Uploads & User Content ──────────────────────────────────────────────────
# User-uploaded files (only if storing locally)
uploads/
tmp/
temp/

# ─── Misc ────────────────────────────────────────────────────────────────────
# Other commonly ignored files
.vscode-test
.history/
*.orig
*.rej
.lock-wscript
lib-cov
pids
*.pid
*.seed
*.pid.lock
.grunt
.lock-wscript
.node_repl_history
*.tgz
.npm
.eslintcache

# ════════════════════════════════════════════════════════════════════════════
# Security Reminder:
# ════════════════════════════════════════════════════════════════════════════
# ✅ NEVER commit .env files with real credentials
# ✅ NEVER commit private keys, certificates, or secrets
# ✅ Always use .env.example for documentation
# ✅ Review changes before committing sensitive files
# ════════════════════════════════════════════════════════════════════════════
